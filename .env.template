# Read by docker compose to provision the database container.
MARIADB_USER=helibot
MARIADB_PASSWORD=helibot
MARIADB_DATABASE=helibot

# Read by the bot. The HELIBOT_ prefix is required: the config layer only picks up
# variables carrying it, and anything set here overrides helibot.toml.
# Outside compose, point this at the host you reach the database on, e.g.
# mysql://helibot:helibot@localhost:3306/helibot
HELIBOT_DATABASE_URL=mysql://helibot:helibot@db:3306/helibot
HELIBOT_DISCORD_TOKEN=

# error | warn | info | debug | trace, optionally per module: info,helibot=debug
RUST_LOG=info

#leave empty for local images
DOCKER_IMAGE_URL_BASE=ghcr.io/eli-sauvage/
